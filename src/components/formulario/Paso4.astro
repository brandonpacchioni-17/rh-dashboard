<div class="space-y-6">


      <span class="text-indigo-600 font-semibold">
    Paso 4 de 4
  </span>

  <div class="w-full h-2 bg-slate-200 rounded-full mt-5 mb-8">
    <div class="w-4/4 h-full bg-indigo-600 rounded-full"></div>
  </div>

    <h2 class="text-2xl font-bold text-slate-800">
        Finalizar postulación
    </h2>


    <p class="text-slate-500">
        Revisa tus datos antes de enviar tu postulación.
    </p>


    <div class="bg-slate-100 rounded-xl p-5 space-y-3">

        <h3 class="font-semibold text-slate-700">
            Resumen
        </h3>

        <p>
            Verifica que toda la información ingresada sea correcta.
        </p>

    </div>

    <div class="grid md:grid-cols-2 gap-6">

  <div>

    <label class="block mb-2 font-medium text-slate-700">
      LinkedIn (opcional)
    </label>

    <input
      type="url"
      id="linkedin"
      placeholder="https://linkedin.com/in/usuario"
      class="w-full border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium text-slate-700">
      GitHub / Portafolio (opcional)
    </label>

    <input
      type="url"
      id="github"
      placeholder="https://github.com/usuario"
      class="w-full border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

</div>

<div>

  <label class="block mb-3 font-medium text-slate-700">
    Adjuntar CV
  </label>

  <label
    for="cv"
    class="flex flex-col items-center justify-center w-full border-2 border-dashed border-slate-300 rounded-2xl p-8 cursor-pointer hover:border-indigo-500 hover:bg-indigo-50 transition">

    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-12 h-12 text-indigo-600 mb-3"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor">

      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
      />

    </svg>

    <p class="font-semibold text-slate-700">
      Haz clic para seleccionar tu CV
    </p>

    <p class="text-sm text-slate-500 mt-2">
      PDF, DOC o DOCX (Máximo 5 MB)
    </p>

  </label>

  <input
    id="cv"
    type="file"
    accept=".pdf,.doc,.docx"
    class="hidden"
  />

  <p
    id="nombre-cv"
    class="text-sm text-green-600 mt-3 hidden">
  </p>

</div>


<div class="flex items-start gap-3">

    <input
        type="checkbox"
        id="terminos"
        class="mt-1"
    />

    <label
        for="terminos"
        class="text-slate-600 leading-relaxed"
    >
        He leído y acepto los

        <button
            type="button"
            id="abrir-terminos"
            class="text-indigo-600 hover:underline font-medium"
        >
            Términos y Condiciones
        </button>

        y la

        <button
            type="button"
            id="abrir-privacidad"
            class="text-indigo-600 hover:underline font-medium"
        >
            Política de Privacidad
        </button>.

    </label>

</div>



    <div class="flex justify-between pt-6">

        <button
            id="btn-anterior-4"
            class="px-6 py-3 rounded-xl bg-slate-200 hover:bg-slate-300"
        >
            Anterior
        </button>


        <button
            id="btn-enviar"
            class="px-6 py-3 rounded-xl bg-green-600 text-white hover:bg-green-700"
        >
            Enviar postulación
        </button>

    </div>


</div>


<div
  id="modal-legal"
  class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 px-6">

  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl">

    <div class="border-b px-6 py-4">

      <h2
        id="titulo-legal"
        class="text-2xl font-bold text-slate-800">
      </h2>

    </div>

    <div
      id="contenido-legal"
      class="p-6 text-slate-600 leading-8 max-h-[60vh] overflow-y-auto">
    </div>

    <div class="border-t px-6 py-4 flex justify-end">

      <button
        id="cerrar-legal"
        class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-xl">

        Cerrar

      </button>

    </div>

  </div>

</div>