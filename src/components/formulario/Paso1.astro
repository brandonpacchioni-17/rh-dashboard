<div class="mb-10">

  <span class="text-indigo-600 font-semibold">
    Paso 1 de 4
  </span>

  <div class="w-full h-2 bg-slate-200 rounded-full mt-5 mb-8">
    <div class="w-1/4 h-full bg-indigo-600 rounded-full"></div>
  </div>

  <h1 class="text-4xl font-bold text-slate-800 mt-2">
    Datos Personales
  </h1>

  <p class="mt-3 text-slate-500">
    Completa la siguiente información para iniciar tu postulación.
  </p>

</div>

<div class="grid md:grid-cols-2 gap-6">

  <div>

    <label class="block mb-2 font-medium">
      Nombres
    </label>

    <input
      type="text"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Apellidos
    </label>

    <input
      type="text"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Correo electrónico
    </label>

    <input
      type="email"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Celular
    </label>

    <input
      type="tel"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block text-sm font-medium">
    DNI
    </label>

    <input
    id="dni"
    type="text"
    maxlength="8"
    placeholder="Ingrese su DNI"
    class="w-full mt-2 px-4 py-3 rounded-xl border"
    />

  </div>

    <div>
      <label class="block text-sm font-medium">
      Fecha de nacimiento
      </label>

      <input
      type="date"
      id="fechaNacimiento"
      class="w-full border rounded-lg p-3"
      />
    </div>

</div>

<div class="flex justify-end mt-10">

<button
  id="btn-siguiente-1"
  class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-xl transition">

  Siguiente →

</button>

</div>