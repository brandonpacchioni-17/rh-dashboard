<div class="mb-10">

  <span class="text-indigo-600 font-semibold">
    Paso 2 de 4
  </span>

  <div class="w-full h-2 bg-slate-200 rounded-full mt-5 mb-8">
    <div class="w-2/4 h-full bg-indigo-600 rounded-full"></div>
  </div>

  <h1 class="text-4xl font-bold text-slate-800">
    Información Laboral
  </h1>

  <p class="mt-3 text-slate-500">
    Cuéntanos a qué puesto deseas postular.
  </p>

</div>

<div class="grid md:grid-cols-2 gap-6">

  <div>

    <label class="block mb-2 font-medium">
      Área
    </label>

    <select class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">

      <option>Recursos Humanos</option>
      <option>Tecnología</option>
      <option>Marketing</option>
      <option>Ventas</option>
      <option>Administración</option>
      <option>Finanzas</option>

    </select>

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Puesto
    </label>

    <input
      type="text"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Años de experiencia
    </label>

    <input
      type="number"
      min="0"
      class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />

  </div>

  <div>

    <label class="block mb-2 font-medium">
      Modalidad
    </label>

    <select class="w-full border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">

      <option>Presencial</option>
      <option>Híbrido</option>
      <option>Remoto</option>

    </select>

  </div>

</div>

<div class="flex justify-between mt-10">

  <button
    class="border border-slate-300 px-8 py-3 rounded-xl hover:bg-slate-100 transition">

