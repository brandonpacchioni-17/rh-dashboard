---
---

<section class="min-h-screen bg-slate-50">

    <nav class="bg-white shadow-sm border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <div class="flex items-center gap-3">
      <img
        src="/imagenes/android-chrome-192x192.png"
        alt="Mejicorp"
        class="w-10 h-10 rounded-lg"
      />

      <div>
        <h1 class="text-xl font-bold text-slate-800">
          Mejicorp
        </h1>

        <p class="text-xs text-slate-500">
          Innovating Your Future
        </p>
      </div>
    </div>

    <button
      class="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition">
      Iniciar sesión
    </button>

  </div>
</nav>

<section class="max-w-7xl mx-auto px-6 py-20">

  <div class="grid lg:grid-cols-2 gap-16 items-center">

    <!-- TEXTO -->

    <div>

      <span class="inline-block px-4 py-1 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-6">
        ¡Estamos contratando!
      </span>

      <h1 class="text-5xl font-extrabold text-slate-800 leading-tight">
        Construye tu futuro profesional con <span class="text-indigo-600">Mejicorp</span>
      </h1>

      <p class="mt-6 text-lg text-slate-600 leading-8">
        Buscamos personas comprometidas, con ganas de aprender, crecer y formar parte de un equipo que apuesta por la innovación.
      </p>

      <div class="flex gap-4 mt-10">

        <button class="px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold transition">
          Postular ahora
        </button>

        <button class="px-8 py-4 rounded-xl border border-slate-300 hover:bg-slate-100 transition">
          Ver vacantes
        </button>

      </div>

    </div>

    <!-- IMAGEN -->

    <div class="flex justify-center">

      <img
        src="/imagenes/android-chrome-512x512.png"
        alt="Mejicorp"
        class="w-72 drop-shadow-2xl"
      />

    </div>

  </div>

</section>

</section>

