---
---

<section class="min-h-screen bg-slate-50">

    <nav class="bg-white shadow-sm border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <div class="flex items-center gap-3">
      <img
        src="/imagenes/android-chrome-192x192.png"
        alt="Mejicorp"
        class="w-12 h-12 rounded-lg"
      />

      <div>
        <h1 class="text-xl font-bold text-slate-800">
          Mejicorp
        </h1>

        <p class="text-xs text-slate-500">
          Innovating Your Future
        </p>
      </div>
    </div>

    <button
      class="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition">
      Iniciar sesión
    </button>

  </div>
</nav>

<section class="max-w-7xl mx-auto px-6 py-20">

  <div class="grid lg:grid-cols-2 gap-16 items-center">

    <!-- TEXTO -->

    <div>

      <span class="inline-block px-4 py-1 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-6">
        ¡Estamos contratando!
      </span>

      <h1 class="text-5xl font-extrabold text-slate-800 leading-tight">
        Construye tu futuro profesional con <span class="text-indigo-600">Mejicorp</span>
      </h1>

      <p class="mt-6 text-lg text-slate-600 leading-8">
        Buscamos personas comprometidas, con ganas de aprender, crecer y formar parte de un equipo que apuesta por la innovación.
      </p>

      <div class="flex gap-4 mt-10">

        <a
          href="/postular"
          class="px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold transition inline-block text-center"
        >
          Postular ahora
        </a>

        <button class="px-8 py-4 rounded-xl border border-slate-300 hover:bg-slate-100 transition">
          Ver vacantes
        </button>

      </div>

    </div>

    <!-- IMAGEN -->

    <div class="flex justify-center">

      <img
        src="/imagenes/android-chrome-512x512.png"
        alt="Mejicorp"
        class="w-72 drop-shadow-2xl"
      />

    </div>

  </div>

<section class="max-w-7xl mx-auto px-6 py-32">

  <div class="text-center mb-14">

    <h2 class="text-4xl font-bold text-slate-800">
      ¿Por qué trabajar con Mejicorp?
    </h2>

    <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
      Creemos en el crecimiento de las personas, fomentamos la innovación y ofrecemos un entorno donde cada colaborador puede desarrollar su máximo potencial.
    </p>

  </div>

  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl transition">
      <div class="text-5xl mb-5">📈</div>
      <h3 class="text-xl font-semibold mb-3">Crecimiento Profesional</h3>
      <p class="text-slate-600">
        Impulsamos el desarrollo de nuestros colaboradores con oportunidades de crecimiento interno.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl transition">
      <div class="text-5xl mb-5">🎓</div>
      <h3 class="text-xl font-semibold mb-3">Capacitación Continua</h3>
      <p class="text-slate-600">
        Aprender constantemente es parte de nuestra cultura organizacional.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl transition">
      <div class="text-5xl mb-5">🤝</div>
      <h3 class="text-xl font-semibold mb-3">Trabajo en Equipo</h3>
      <p class="text-slate-600">
        Valoramos el respeto, la colaboración y el compromiso entre todas las áreas.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl transition">
      <div class="text-5xl mb-5">💡</div>
      <h3 class="text-xl font-semibold mb-3">Innovación</h3>
      <p class="text-slate-600">
        Buscamos personas con iniciativa y ganas de aportar nuevas ideas.
      </p>
    </div>

  </div>

</section>

<section class="max-w-7xl mx-auto px-6 py-24">

  <div class="text-center mb-14">

    <h2 class="text-4xl font-bold text-slate-800">
      Vacantes Disponibles
    </h2>

    <p class="mt-4 text-slate-600">
      Encuentra la oportunidad que mejor se adapte a tu perfil y forma parte de nuestro equipo.
    </p>

  </div>

  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

    <!-- TARJETA 1 -->

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl hover:-translate-y-2 transition duration-300">

      <h3 class="text-2xl font-bold text-slate-800">
        Auxiliar de Recursos Humanos
      </h3>

      <p class="mt-3 text-slate-500">
        📍 Lima · Tiempo completo
      </p>

      <p class="mt-5 text-slate-600">
        Apoya los procesos de selección, contratación y seguimiento del personal.
      </p>

      <a
        href="/postular"
        class="mt-8 w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold transition block text-center"
      >
        Postular
      </a>

    </div>

    <!-- TARJETA 2 -->

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl hover:-translate-y-2 transition duration-300">

      <h3 class="text-2xl font-bold text-slate-800">
        Asistente Administrativo
      </h3>

      <p class="mt-3 text-slate-500">
        📍 Lima · Tiempo completo
      </p>

      <p class="mt-5 text-slate-600">
        Organización de documentos, atención interna y apoyo administrativo.
      </p>

      <a
        href="/postular"
        class="mt-8 w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold transition block text-center"
      >
        Postular
      </a>

    </div>

    <!-- TARJETA 3 -->

    <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-xl hover:-translate-y-2 transition duration-300">

      <h3 class="text-2xl font-bold text-slate-800">
        Practicante de Sistemas
      </h3>

      <p class="mt-3 text-slate-500">
        📍 Lima · Medio tiempo
      </p>

      <p class="mt-5 text-slate-600">
        Apoya en el desarrollo y mantenimiento de aplicaciones internas.
      </p>

      <a
        href="/postular"
        class="mt-8 w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold transition block text-center"
      >
        Postular
      </a>

    </div>

  </div>

</section>

<section class="bg-slate-900 text-white py-24">

  <div class="max-w-7xl mx-auto px-6">

    <div class="grid lg:grid-cols-2 gap-14 items-center">

      <!-- TEXTO -->

      <div>

        <span class="text-indigo-400 font-semibold">
          ¿Necesitas ayuda?
        </span>

        <h2 class="text-4xl font-bold mt-3">
          Estamos para ayudarte
        </h2>

        <p class="mt-6 text-slate-300 leading-8">
          Si tienes alguna consulta sobre nuestras vacantes o el proceso de selección, puedes comunicarte con nuestro equipo de Recursos Humanos.
        </p>

      </div>

      <!-- DATOS -->

      <div class="space-y-6">

        <div class="bg-slate-800 rounded-2xl p-6">

          <h3 class="font-semibold text-lg">
            📧 Correo
          </h3>

          <p class="text-slate-300 mt-2">
            rrhh@mejicorp.com
          </p>

        </div>

        <div class="bg-slate-800 rounded-2xl p-6">

          <h3 class="font-semibold text-lg">
            📱 WhatsApp
          </h3>

          <p class="text-slate-300 mt-2">
            +51 999 999 999
          </p>

        </div>

        <div class="bg-slate-800 rounded-2xl p-6">

          <h3 class="font-semibold text-lg">
            📍 Oficina
          </h3>

          <p class="text-slate-300 mt-2">
            Lima, Perú
          </p>

        </div>

      </div>

    </div>

  </div>

</section>

</section>

