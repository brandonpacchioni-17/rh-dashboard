---
import "../styles/global.css";
---

<section
  id="seccion-reportes"
  class="hidden p-6 flex-1 overflow-y-auto bg-slate-100 dark:bg-slate-900 transition-all duration-300"
>

  <!-- HEADER -->

  <div class="flex items-center justify-between mb-6">

    <div>
      <h1 class="text-4xl font-bold text-slate-800 dark:text-white">
        Reportes
      </h1>

    </div>

  </div>

  <!-- KPIs -->

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">
      <p class="text-slate-500 dark:text-slate-400">
        Total empleados
      </p>

      <h2
        id="reporteTotal"
        class="text-4xl font-bold mt-2 text-slate-800 dark:text-white"
      >
        0
      </h2>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">
      <p class="text-slate-500 dark:text-slate-400">
        Contratados
      </p>

      <h2
        id="reporteContratados"
        class="text-4xl font-bold mt-2 text-emerald-500"
      >
        0
      </h2>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">
      <p class="text-slate-500 dark:text-slate-400">
        Entrevistas
      </p>

      <h2
        id="reporteEntrevistas"
        class="text-4xl font-bold mt-2 text-cyan-500"
      >
        0
      </h2>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">
      <p class="text-slate-500 dark:text-slate-400">
        Postulantes truncos
      </p>

      <h2
        id="reporteVencidos"
        class="text-4xl font-bold mt-2 text-red-500"
      >
        0
      </h2>
    </div>

  </div>

  <!-- GRÁFICOS -->

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">

    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">

      <h2 class="text-xl font-bold mb-4 text-slate-800 dark:text-white">
        Estado de Etapas
      </h2>
     <div class="h-[350px]">
        <canvas id="graficoReportes" class="max-h-[350px]"></canvas>
    
     </div>

    </div>


  <!-- TABLA -->

  <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow transition-all duration-300">

    <div class="flex items-center justify-between mb-6">

      <div class="flex justify-end mb-4">

        <button
          onclick="exportarCSV()"
          class="
            bg-green-600 hover:bg-green-700
            text-white px-4 py-2 rounded-lg
          "
        >
         Exportar Reporte
        </button>

      </div>

      <h2 class="text-2xl font-bold text-slate-800 dark:text-white">
        Resumen general
      </h2>

    </div>

    <div class="overflow-x-auto">

      <table class="w-full text-left">

        <thead>

          <tr class="border-b border-slate-200 dark:border-slate-700">

            <th class="py-3 text-slate-500">
              Área
            </th>

            <th class="py-3 text-slate-500">
              Total
            </th>

            <th class="py-3 text-slate-500">
              Contratados
            </th>

            <th class="py-3 text-slate-500">
              Pendientes
            </th>
            <th class="py-3 text-slate-500">
              % Contratación
            </th>

          </tr>

        </thead>

        <tbody id="tablaReportes">

        </tbody>

      </table>

    </div>

  </div>

</section>