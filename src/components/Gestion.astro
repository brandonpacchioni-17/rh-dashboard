<div id="seccion-gestion" class="hidden transition-all duration-300 animate-fade">

  <!-- BUSCADOR -->

  <div class="mb-6">
    <input 
      id="buscador"
      type="text"
      placeholder="Buscar empleado..."
      class="buscador border p-2 w-full rounded-lg"
      oninput="buscar()"
    />
  </div>

  <!-- FILTROS -->
  <div class="flex flex-wrap gap-2 md:gap-3 mb-6">

    <button
      onclick="setFiltro('todos')"
      class="filtroTodos px-3 py-1 bg-slate-900 text-white rounded-lg"
    >
      Todos
    </button>

    <button
      onclick="setFiltro('Postulante')"
      class="px-3 py-1 bg-yellow-500 text-white rounded-lg"
    >
      Postulante
    </button>

    <button
      onclick="setFiltro('Entrevista virtual')"
      class="px-3 py-1 bg-blue-500 text-white rounded-lg"
    >
      Virtual
    </button>

    <button
      onclick="setFiltro('Entrevista presencial')"
      class="px-3 py-1 bg-cyan-600 text-white rounded-lg"
    >
      Presencial
    </button>

    <button
      onclick="setFiltro('Seleccionado')"
      class="px-3 py-1 bg-green-600 text-white rounded-lg"
    >
      Seleccionado
    </button>

  </div>

  <!-- ACCIONES -->
  <button
    id="btnAgregarEmpleado"
    onclick="abrirModal()"
    class="botonAgregar bg-cyan-500 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg mb-6 shadow-lg"
  >
    + Agregar empleado
  </button>

  <!-- TABLA -->
  <div class="card bg-white p-4 rounded-2xl shadow">

    <h3 class="text-2xl font-bold mb-4">
      Base de postulantes
    </h3>

    <div class="overflow-x-auto">

      <table class="w-full text-left border-collapse">

        <thead class="border-b">
          <tr>
            <th class="pb-3">Postulante</th>
            <th class="pb-3">Puesto</th>
            <th class="pb-3">Área</th>
            <th class="pb-3">Fecha de postulación</th>
            <th class="pb-3">Fecha de ingreso</th>
            <th class="pb-3">Etapa</th>
            <th class="pb-3">Comentario (entrevista)</th>
            <th class="pb-3">Acciones</th>
          </tr>
        </thead>

        <tbody id="tabla-body"></tbody>

      </table>

    </div>

  </div>

</div>