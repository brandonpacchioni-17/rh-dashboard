<div
  id="seccion-dashboard"
  class="transition-all duration-300 animate-fade"
>

  <!-- CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-10">

    <div class="card bg-white p-6 rounded-2xl shadow">
      <p class="tituloCard text-gray-500">
        Empleados
      </p>

      <p id="total-empleados" class="text-4xl font-bold">
        0
      </p>
    </div>

    <div class="card bg-white p-6 rounded-2xl shadow">
      <p class="tituloCard text-gray-500">
        Actividades
      </p>

      <p id="total-actividades" class="text-4xl font-bold">
        0
      </p>
    </div>

    <div class="card bg-white p-6 rounded-2xl shadow">
      <p class="tituloCard text-gray-500">
        Áreas
      </p>

      <p id="total-pendientes" class="text-4xl font-bold">
        0
      </p>
    </div>

    <div class="card bg-white p-6 rounded-2xl shadow">
      <p class="tituloCard text-gray-500">
        Postulantes truncos
      </p>

      <p
        id="total-vencidas"
        class="text-4xl font-bold text-red-500"
      >
        0
      </p>
    </div>


  

    <div class="card bg-white p-6 rounded-2xl shadow-lg col-span-1 md:col-span-4">

      <div class="flex justify-between items-center mb-3">

        <h2
          id="tituloProgreso"
          class="text-xl font-bold"
        >
          Progreso General
        </h2>

        <span
          id="porcentaje-progreso"
          class="font-bold text-blue-500 text-lg"
        >
          0%
        </span>

      </div>

      <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-6 overflow-hidden">

        <div
          id="barra-progreso"
          class="bg-blue-500 h-6 transition-all duration-500"
          style="width: 0%"
        ></div>

      </div>

    </div>

  </div>

  <!-- GRÁFICO -->
  <div class="card bg-white p-6 rounded-2xl shadow">

    <h3 class="text-2xl font-bold mb-4">
      Estado de Actividades
    </h3>

    <div class="h-72 w-full overflow-hidden">
      <canvas id="graficoEstados"></canvas>
    </div>

  </div>

</div>