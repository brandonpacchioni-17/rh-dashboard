<section 
id="seccion-postulantes" 
class="hidden min-h-full transition-all duration-300"
>

  <div class="flex items-center justify-between mb-8">

    <div>

      <p class="text-slate-500 dark:text-slate-400 mt-2">
        Gestiona todas las postulaciones recibidas desde el portal de empleo.
      </p>

    </div>

  </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

  <div class="card bg-white rounded-2xl shadow p-6 transition-all duration-300">

    <p class="tituloCard text-slate-500 text-sm">
      Total de postulantes
    </p>

    <h3 id="card-total-postulantes" class="numeroCard text-3xl font-bold text-slate-800 mt-2">
      0
    </h3>

  </div>

<div class="card bg-white rounded-2xl shadow p-6 transition-all duration-300">

  <p class="tituloCard text-slate-500 text-sm">
    En evaluación
  </p>

  <h3 id="card-evaluacion-postulantes" class="numeroCard text-3xl font-bold text-slate-800 mt-2">
    0
  </h3>

</div>

<div class="card bg-white rounded-2xl shadow p-6 transition-all duration-300">

    <p class="tituloCard text-slate-500 text-sm">
      Aceptados
    </p>

    <h3 id="card-contratados-postulantes" class="numeroCard text-3xl font-bold text-slate-800 mt-2">
      0
    </h3>

  </div>

</div>

<div class="card bg-white rounded-2xl shadow overflow-hidden">

  <table class="w-full">

    <thead class="bg-slate-100 dark:bg-slate-700 transition">

      <tr>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Nombre
        </th>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Área
        </th>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Puesto
        </th>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Fecha
        </th>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Estado
        </th>

        <th class="text-left p-4 text-slate-700 dark:text-slate-200">
          Acciones
        </th>

      </tr>

    </thead>

    <tbody id="tabla-postulantes">

    </tbody>

  </table>

  <div id="modal-postulante" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

<div id="modal-postulante-contenido" class="modal-container card bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto transition-all duration-300">

    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-700 p-6">

      <h2 class="modal-header-title text-3xl font-bold text-slate-800">
          Información del postulante
      </h2>

      <button id="cerrar-modal-postulante" class="text-3xl">

        ×

      </button>

    </div>

    <div id="contenido-postulante" class="p-6">

    </div>

  </div>

</div>

</div>  



</section>