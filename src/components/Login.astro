<div
  id="loginScreen"
  class="min-h-screen flex items-center justify-center bg-slate-900 p-4"
>

  <div class="bg-white w-full max-w-md rounded-2xl p-8 shadow-2xl">

    <h1 class="text-3xl font-bold text-center mb-2">
      Sistema RH
    </h1>

    <p class="text-slate-500 text-center mb-6">
      Iniciar sesión
    </p>

    <select
      id="loginRol"
      class="border p-3 rounded-lg bg-slate-100 mb-4"
    >

      <option value="admin">
        Administrador
      </option>

      <option value="rrhh">
        RRHH
      </option>

      <option value="supervisor">
        Supervisor
      </option>

    </select>

    <input
      id="loginUsuario"
      type="text"
      placeholder="Usuario"
      class="border p-3 w-full rounded-lg mb-4"
    />

    <input
      id="loginPassword"
      type="password"
      placeholder="Contraseña"
      class="border p-3 w-full rounded-lg mb-4"
    />

    <p
      id="loginError"
      class="text-red-500 text-sm hidden mb-4"
    >
      Credenciales incorrectas
    </p>

    <button
      onclick="iniciarSesion()"
      class="w-full bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-lg transition-all"
    >
      Ingresar
    </button>

  </div>

</div>